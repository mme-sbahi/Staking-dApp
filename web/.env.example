# Free project id from https://cloud.reown.com (needed for WalletConnect / mobile wallets; browser wallets work without it)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional custom Sepolia RPC (defaults to a public endpoint)
NEXT_PUBLIC_SEPOLIA_RPC_URL=
# 11155111 = Sepolia (default), 31337 = local Hardhat node for development
NEXT_PUBLIC_CHAIN_ID=11155111
